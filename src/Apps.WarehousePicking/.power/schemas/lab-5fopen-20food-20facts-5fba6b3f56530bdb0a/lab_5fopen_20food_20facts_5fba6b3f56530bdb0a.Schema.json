    "swagger": {
      "swagger": "2.0",
      "info": {
        "title": "Open Food Facts",
        "description": "Look up product data (name, brand, quantity, image) by barcode from the Open Food Facts public database. No API key required.",
        "version": "1.0"
      },
      "host": "402922a697a0e2b9be7ca0a9918abf.1c.environment.api.powerplatform.com",
      "basePath": "/connectors/runtime/invoke/scalegroups/usa002/shards/06/apis/lab-5fopen-20food-20facts-5fba6b3f56530bdb0a/connections/",
      "schemes": [
        "https"
      ],
      "consumes": [],
      "produces": [
        "application/json"
      ],
      "paths": {
        "/{connectionId}/product/{barcode}.json": {
          "get": {
            "summary": "Get product by barcode",
            "description": "Looks up a product by its EAN/UPC barcode and returns its name, brand, quantity, and image URL.",
            "operationId": "GetProductByBarcode",
            "x-ms-visibility": "important",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "barcode",
                "in": "path",
                "required": true,
                "type": "string",
                "description": "The product's EAN-13 or UPC-A barcode.",
                "x-ms-summary": "Barcode"
              }
            ],
            "responses": {
              "200": {
                "description": "Product found",
                "schema": {
                  "$ref": "#/definitions/Product"
                }
              }
            }
          }
        },
        "/{connectionId}/product-image": {
          "get": {
            "summary": "Get product image",
            "description": "Proxies image bytes returned by Open Food Facts for code-app callers.",
            "operationId": "GetProductImage",
            "x-ms-visibility": "important",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "imageUrl",
                "in": "query",
                "required": true,
                "type": "string",
                "description": "The image URL returned by GetProductByBarcode.",
                "x-ms-summary": "Image URL"
              }
            ],
            "produces": [
              "image/jpeg",
              "image/png"
            ],
            "responses": {
              "200": {
                "description": "Image bytes",
                "schema": {
                  "type": "file"
                }
              }
            },
            "x-ms-media-kind": "image"
          }
        }
      },
      "definitions": {
        "Product": {
          "type": "object",
          "properties": {
            "ean": {
              "type": "string",
              "description": "The barcode that was looked up.",
              "x-ms-summary": "EAN"
            },
            "name": {
              "type": "string",
              "description": "The product's name.",
              "x-ms-summary": "Name"
            },
            "brand": {
              "type": "string",
              "description": "The product's brand.",
              "x-ms-summary": "Brand"
            },
            "quantity": {
              "type": "string",
              "description": "The product's package quantity as free text.",
              "x-ms-summary": "Quantity"
            },
            "imageUrl": {
              "type": "string",
              "description": "URL of the product's front-of-pack image.",
              "x-ms-summary": "Image URL"
            }
          }
        }
      }
    },
